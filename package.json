{
  "name": "magic-metal-sales-funnel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "serve . -l 4173 --no-clipboard",
    "validate:html": "html-validate \"*.html\" \"catalog/**/*.html\" \"uz/**/*.html\"",
    "check:js": "node --check app.js && node --check site-config.js && node --check site-shell.js && node --check catalog/catalog.js",
    "check:contacts": "node tests/check-contacts.js",
    "test:e2e": "playwright test tests/site.spec.js",
    "test:visual:capture": "playwright test tests/visual-capture.spec.js",
    "test:ci": "npm run check:js && npm run validate:html && npm run check:contacts && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "quality": "npm run test:ci && npm run lighthouse"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "html-validate": "^10.1.2",
    "serve": "^14.2.5"
  },
  "engines": {
    "node": ">=20"
  }
}
